#!/usr/bin/env nu

# Set the next boot to Windows and reboot into it.

def main [] {
    # Look up the boot number for Windows in the EFI records.
    let windows = (
        ^efibootmgr
        | lines
        | parse --regex '^Boot(?<num>[0-9A-Fa-f]{4})\*?\s+(?<label>.*)$'
        | where label =~ '^Windows'
    )

    if ($windows | is-empty) {
        print "Cannot find Windows boot in EFI, exiting"
        exit 1
    }

    let boot_number = ($windows | first | get num)

    # Set next boot to be Windows and reboot the machine.
    ^sudo efibootmgr -n $boot_number
    ^reboot
}
