#!/usr/bin/env bash
# CakeOS Update Script
# Updates the system configuration from the upstream repository while preserving dynamic elements.

set -e

# Configuration
# Ssh method
REPO_URL="git@github.com:Kex1016/cakeos.git"
# Https method
# REPO_URL="https://github.com/Kex1016/cakeos.git"

BRANCH="main"
TARGET_DIR="/etc/cakeos"

# Ensure we are running as root
if [ "$EUID" -ne 0 ]; then
    echo "==> This script needs root privileges to update $TARGET_DIR."
    echo "==> Requesting sudo..."
    exec sudo "$0" "$@"
fi

# Ensure target directory exists
mkdir -p "$TARGET_DIR"
cd "$TARGET_DIR"

echo "==> Updating CakeOS configuration in $TARGET_DIR..."

# For /etc/cakeos, we must NEVER have a .git folder or Nix will ignore 'gen/'
# Ensure any old .git is gone
if [ -d ".git" ]; then
    rm -rf .git
    echo "==> Removed existing .git folder to keep 'gen/' visible."
fi

TMP_DIR=$(mktemp -d)
echo "==> Cloning latest changes to temporary directory..."
if ! git clone --depth 1 -q "$REPO_URL" "$TMP_DIR"; then
    echo "!!! Error: Clone failed."
    rm -rf "$TMP_DIR"
    exit 1
fi

echo "==> Syncing files to $TARGET_DIR..."
# We use rsync to sync files while preserving 'gen/' and excluding '.git'
# If rsync is not available, we use nix-shell to run it
RSYNC_CMD="rsync -av --delete --exclude='.git' --exclude='gen/' '$TMP_DIR/' '$TARGET_DIR/'"
if command -v rsync >/dev/null 2>&1; then
    eval "$RSYNC_CMD > /dev/null"
else
    echo "==> rsync not found. Using nix-shell to run sync..."
    nix shell nixpkgs#rsync -c bash -c "$RSYNC_CMD > /dev/null"
fi

rm -rf "$TMP_DIR"

echo "==> Done! Upstream changes have been applied."
echo "==> Dynamic elements (like the 'gen/' folder) have been preserved."

# Ask to rebuild
read -p "Would you like to apply the changes now? (nixos-rebuild boot) [y/N]: " confirm
if [[ "$confirm" =~ ^[Yy]$ ]]; then
    # Detect the current configuration name from gen/
    CONFIG_NAME=$(ls gen/*.nix 2>/dev/null | grep -v "hardware" | head -n 1 | xargs basename -s .nix)
    
    if [ -z "$CONFIG_NAME" ]; then
        echo "Could not automatically detect configuration name. Please run nixos-rebuild manually."
        exit 0
    fi

    echo "==> Rebuilding system for configuration: $CONFIG_NAME..."
    nixos-rebuild boot --flake ".#$CONFIG_NAME"

    if [ $? -eq 0 ]; then
        echo "==> Rebuild completed successfully."
        echo "==> Would you like to reboot now? (Y/n): "
        read -r reboot_confirm
        [[ -z "$reboot_confirm" ]] && reboot_confirm="Y"
        if [[ "$reboot_confirm" =~ ^[Yy]$ ]]; then
            echo "==> Rebooting..."
            sudo reboot
        fi
    else
        echo "==> Rebuild failed. Please check the logs."
    fi
fi
