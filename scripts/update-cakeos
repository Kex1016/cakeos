#!/usr/bin/env nu

# CakeOS Update Script
# Updates the system configuration from the upstream repository while
# preserving dynamic elements.

# Ssh method
const REPO_URL = "git@github.com:Kex1016/cakeos.git"
# Https method
# const REPO_URL = "https://github.com/Kex1016/cakeos.git"

# TEMPORARY: track the modularity branch until it lands on main.
const BRANCH = "modularity"
const TARGET_DIR = "/etc/cakeos"

def main [] {
    # Ensure we are running as root.
    if ((^id -u | into int) != 0) {
        print $"==> This script needs root privileges to update ($TARGET_DIR)."
        print "==> Requesting sudo..."
        exec sudo $nu.current-exe $env.CURRENT_FILE
    }

    # Ensure target directory exists.
    mkdir $TARGET_DIR
    cd $TARGET_DIR

    print $"==> Updating CakeOS configuration in ($TARGET_DIR)..."

    # For /etc/cakeos, we must NEVER have a .git folder or Nix will ignore
    # 'gen/'. Ensure any old .git is gone.
    if (".git" | path exists) {
        rm -rf .git
        print "==> Removed existing .git folder to keep 'gen/' visible."
    }

    let tmp_dir = (^mktemp -d | str trim)
    print "==> Cloning latest changes to temporary directory..."

    try {
        ^git clone --depth 1 -b $BRANCH -q $REPO_URL $tmp_dir
    } catch {
        print "!!! Error: Clone failed."
        rm -rf $tmp_dir
        exit 1
    }

    print $"==> Syncing files to ($TARGET_DIR)..."
    # rsync keeps 'gen/' and skips '.git'. If rsync is missing we borrow one
    # from nixpkgs for the duration of the sync.
    let rsync_args = [
        -a
        --delete
        --exclude=.git
        --exclude=gen/
        $"($tmp_dir)/"
        $"($TARGET_DIR)/"
    ]

    if (which rsync | is-not-empty) {
        ^rsync ...$rsync_args out> /dev/null
    } else {
        print "==> rsync not found. Using nix shell to run sync..."
        ^nix shell nixpkgs#rsync -c rsync ...$rsync_args out> /dev/null
    }

    rm -rf $tmp_dir

    print "==> Done! Upstream changes have been applied."
    print "==> Dynamic elements (like the 'gen/' folder) have been preserved."

    # Ask to rebuild.
    let confirm = (input "Would you like to apply the changes now? (nixos-rebuild boot) [y/N]: ")
    if ($confirm !~ '(?i)^y') {
        return
    }

    # Detect the current configuration name from gen/.
    let config_name = (
        glob "gen/*.nix"
        | where { |p| not ($p | path basename | str contains "hardware") }
        | each { |p| $p | path basename | str replace --regex '\.nix$' "" }
        | first
    )

    if ($config_name | is-empty) {
        print "Could not automatically detect configuration name. Please run nixos-rebuild manually."
        return
    }

    print $"==> Rebuilding system for configuration: ($config_name)..."

    try {
        ^nixos-rebuild boot --flake $".#($config_name)"
    } catch {
        print "==> Rebuild failed. Please check the logs."
        return
    }

    print "==> Rebuild completed successfully."
    let reboot_confirm = (input "==> Would you like to reboot now? (Y/n): ")
    if ($reboot_confirm == "" or $reboot_confirm =~ '(?i)^y') {
        print "==> Rebooting..."
        ^sudo reboot
    }
}
