#!/usr/bin/env nu

# CakeOS Update Script
# Updates the system configuration from the upstream repository while
# preserving dynamic elements.
#
#   update-cakeos                      interactive: sync, then offer to rebuild and reboot
#   update-cakeos check [--json]       is upstream ahead of what's installed? (no root needed)
#   update-cakeos apply --mode boot    non-interactive sync + `nixos-rebuild <mode>` (root;
#                                      the shell's updater runs this through sudo)

# HTTPS, not SSH: the script re-runs itself as root (sudo), and root has no
# SSH key for GitHub. The repo is public, so an anonymous clone works.
const REPO_URL = "https://github.com/Kex1016/cakeos.git"
const API = "https://api.github.com/repos/Kex1016/cakeos"

# Keep in step with cakeos-wm's BRANCH.
const BRANCH = "main"
# Branches that were merged into main: machines that recorded one follow main.
const RETIRED_BRANCHES = ["feat/hecate" "modularity"]
const TARGET_DIR = "/etc/cakeos"
# Which upstream commit is installed: written after every sync (and by the
# installer and cakeos-wm), read by `check`. Not part of the repo.
const VERSION_FILE = ".cakeos-version"

# This copy hands over to the latest CakeOS's updater, which decides where updates come from
# and how they're applied, however old the install. That copy runs with CAKEOS_UPDATER_LATEST
# set (the flake package's wrapper sets it).
const LATEST = "github:Kex1016/cakeos#update-cakeos"

def --wrapped run-latest [...args: string] {
    if ($env.CAKEOS_UPDATER_LATEST? | is-not-empty) {
        return
    }
    let code = try {
        ^nix --extra-experimental-features "nix-command flakes" run --refresh $LATEST -- ...$args
        0
    } catch {
        $env.LAST_EXIT_CODE? | default 1
    }
    exit $code
}

def is-root [] {
    (^id -u | into int) == 0
}

# { repo, branch, rev, updated } of the installed CakeOS, or null when unknown
# (installed before versions were recorded).
def installed-version [] {
    let file = ($TARGET_DIR | path join $VERSION_FILE)
    if not ($file | path exists) {
        return null
    }
    try { open --raw $file | from json } catch { null }
}

# The branch to follow: the one this machine was installed from, unless it was retired.
def tracked-branch [installed] {
    let branch = ($installed.branch? | default $BRANCH)
    if $branch in $RETIRED_BRANCHES { $BRANCH } else { $branch }
}

def github [path: string] {
    http get --headers [User-Agent cakeos-updater Accept application/vnd.github+json] $"($API)/($path)"
}

def commit-summary [c] {
    {
        sha: $c.sha
        subject: ($c.commit.message | lines | first)
        author: $c.commit.author.name
        date: $c.commit.author.date
    }
}

# How far the installed CakeOS is behind upstream.
def check-status [] {
    let installed = (installed-version)
    let branch = (tracked-branch $installed)
    let latest = (github $"commits/($branch)").sha
    let rev = $installed.rev?
    if $rev == null {
        # Unknown version: show what's recent, and call it an update.
        let recent = (github $"commits?sha=($branch)&per_page=10" | each { |c| commit-summary $c })
        return {
            installed: null
            branch: $branch
            latest: $latest
            behind: null
            commits: $recent
        }
    }
    if $rev == $latest {
        return { installed: $rev, branch: $branch, latest: $latest, behind: 0, commits: [] }
    }
    let compare = (github $"compare/($rev)...($latest)")
    {
        installed: $rev
        branch: $branch
        latest: $latest
        behind: $compare.ahead_by
        # Newest first, like `git log`.
        commits: ($compare.commits | reverse | first 30 | each { |c| commit-summary $c })
    }
}

# Clone the branch and rsync it over /etc/cakeos, keeping gen/. Returns the new revision.
def sync-upstream [branch: string] {
    mkdir $TARGET_DIR
    cd $TARGET_DIR

    print $"==> Updating CakeOS configuration in ($TARGET_DIR)..."

    # For /etc/cakeos, we must NEVER have a .git folder or Nix will ignore
    # 'gen/'. Ensure any old .git is gone.
    if (".git" | path exists) {
        rm -rf .git
        print "==> Removed existing .git folder to keep 'gen/' visible."
    }

    let tmp_dir = (^mktemp -d | str trim)
    # mktemp makes it 0700, and rsync -a copies the top directory's mode onto
    # /etc/cakeos, which would lock every non-root user out of the flake.
    ^chmod 755 $tmp_dir
    print "==> Fetching the latest CakeOS..."

    try {
        ^git clone --depth 1 -b $branch -q $REPO_URL $tmp_dir
    } catch {
        rm -rf $tmp_dir
        error make { msg: "Clone failed." }
    }
    let rev = (^git -C $tmp_dir rev-parse HEAD | str trim)

    print $"==> Syncing files to ($TARGET_DIR)..."
    # rsync keeps 'gen/' and skips '.git'. If rsync is missing we borrow one
    # from nixpkgs for the duration of the sync.
    let rsync_args = [
        -a
        --delete
        --exclude=.git
        --exclude=gen/
        $"--exclude=/($VERSION_FILE)"
        $"($tmp_dir)/"
        $"($TARGET_DIR)/"
    ]

    if (which rsync | is-not-empty) {
        ^rsync ...$rsync_args out> /dev/null
    } else {
        print "==> rsync not found. Using nix shell to run sync..."
        ^nix shell nixpkgs#rsync -c rsync ...$rsync_args out> /dev/null
    }

    rm -rf $tmp_dir

    {
        repo: $REPO_URL
        branch: $branch
        rev: $rev
        updated: (date now | format date "%+")
    } | to json | save -f ($TARGET_DIR | path join $VERSION_FILE)

    print $"==> Upstream changes applied \(($rev | str substring 0..7)\); 'gen/' was preserved."
    $rev
}

# The flake attribute this machine builds, from gen/<name>.nix.
def config-name [] {
    glob $"($TARGET_DIR)/gen/*.nix"
    | where { |p| not ($p | path basename | str contains "hardware") }
    | each { |p| $p | path basename | str replace --regex '\.nix$' "" }
    | first
}

# The binary caches the configuration being built declares, keys included. The
# build has to use exactly these rather than add them to the running system's:
# its nix.conf is the old CakeOS's, and a cache that one still lists may be dead
# or no longer trusted (the CachyOS kernel's lantian cache was dropped after it
# was compromised).
def target-caches [config: string] {
    (^nix eval --json $"($config).config.nix.settings"
        --apply 's: { substituters = (s.substituters or []) ++ (s.extra-substituters or []); keys = (s.trusted-public-keys or []) ++ (s.extra-trusted-public-keys or []); }'
    | from json)
}

def rebuild [mode: string] {
    let name = (config-name)
    if ($name | is-empty) {
        error make { msg: "Could not detect the configuration name from gen/." }
    }
    print $"==> Rebuilding the system \(nixos-rebuild ($mode), configuration ($name)\)..."
    cd $TARGET_DIR
    let caches = (target-caches $".#nixosConfigurations.($name)")
    (^nixos-rebuild $mode --flake $".#($name)"
        --option substituters ($caches.substituters | str join " ")
        --option trusted-public-keys ($caches.keys | str join " "))
    print "==> Rebuild completed successfully."
}

# Is upstream ahead of the installed CakeOS? Needs no root.
def "main check" [
    --json # machine-readable, for the desktop shell's update checker
] {
    run-latest check ...(if $json { [--json] } else { [] })
    let status = try { check-status } catch { |e|
        if $json {
            print ({ error: $e.msg } | to json -r)
            exit 1
        }
        print $"!!! Could not check for updates: ($e.msg)"
        exit 1
    }
    if $json {
        print ($status | to json -r)
        return
    }
    if $status.behind == 0 {
        print $"CakeOS is up to date \(($status.branch) at ($status.latest | str substring 0..7)\)."
        return
    }
    if $status.behind == null {
        print $"The installed CakeOS version is unknown; ($status.branch) is at ($status.latest | str substring 0..7). Recent changes:"
    } else {
        print $"($status.behind) new change\(s\) on ($status.branch):"
    }
    $status.commits | each { |c| print $"  ($c.sha | str substring 0..7)  ($c.subject)" } | ignore
}

# Sync and rebuild without asking anything (the desktop shell's updater).
def "main apply" [
    --mode: string = "boot" # nixos-rebuild mode: boot (next restart) or switch (now)
] {
    run-latest apply --mode $mode
    if not (is-root) {
        print "!!! `update-cakeos apply` needs root (run it through sudo)."
        exit 1
    }
    if $mode not-in [boot switch] {
        print $"!!! Unknown mode ($mode): boot or switch."
        exit 1
    }
    try {
        sync-upstream (tracked-branch (installed-version)) | ignore
        rebuild $mode
    } catch { |e|
        print $"!!! ($e.msg)"
        exit 1
    }
    print "==> Done."
}

def main [] {
    # Ensure we are running as root.
    if not (is-root) {
        print $"==> This script needs root privileges to update ($TARGET_DIR)."
        print "==> Requesting sudo..."
        exec sudo --preserve-env=CAKEOS_UPDATER_LATEST $nu.current-exe $env.CURRENT_FILE
    }
    run-latest

    try {
        sync-upstream (tracked-branch (installed-version)) | ignore
    } catch { |e|
        print $"!!! Error: ($e.msg)"
        exit 1
    }

    # Ask to rebuild.
    let confirm = (input "Would you like to apply the changes now? (nixos-rebuild boot) [y/N]: ")
    if ($confirm !~ '(?i)^y') {
        return
    }

    try {
        rebuild boot
    } catch { |e|
        print $"==> Rebuild failed: ($e.msg) Please check the logs."
        return
    }

    let reboot_confirm = (input "==> Would you like to reboot now? (Y/n): ")
    if ($reboot_confirm == "" or $reboot_confirm =~ '(?i)^y') {
        print "==> Rebooting..."
        ^sudo reboot
    }
}
