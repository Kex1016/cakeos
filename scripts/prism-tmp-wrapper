#!/usr/bin/env nu

# Prism Launcher Temp Wrapper
# Moves/Copies the instance to /tmp for faster performance (e.g., RAM disk)
# and syncs changes back on exit.

# --- Configuration ---
const TEMP_BASE = "/tmp/prism-instances"
# Add folders to exclude from sync if they are too large and unnecessary
const EXCLUDES = [
    "--exclude=logs/"
    "--exclude=webcache/"
    "--exclude=webcache2/"
]

# --- GUI Helpers ---
def show-error [msg: string] {
    if (which zenity | is-not-empty) {
        ^zenity --error --title "Prism Wrapper Error" --text $msg
    } else {
        print -e $"Error: ($msg)"
    }
}

# Run `action` while a pulsating zenity dialog is on screen. Nushell cannot
# stream a running block's stdout into zenity the way the old bash pipeline
# did, so the dialog is spawned as a job and killed once the work is done.
def with-progress [text: string, action: closure] {
    if (which zenity | is-empty) {
        do $action
        return
    }

    let dialog = (job spawn {
        ^zenity --progress --title "Prism Wrapper" --text $text --pulsate --auto-close --no-cancel
    })

    try { do $action }
    try { job kill $dialog }
}

# Sync the RAM-disk copy back over the backup and put the original directory
# structure back in place.
def restore [inst_dir: string, orig_bak: string, temp_dir: string] {
    with-progress "Finalizing instance and syncing back..." {
        if ($temp_dir | path exists) {
            ^rsync -a --delete ...$EXCLUDES $"($temp_dir)/" $"($orig_bak)/"
        }

        # Point the symlink back at the backup before the final move so the
        # path is never dangling.
        ^ln -sfT $orig_bak $inst_dir
        rm -f $inst_dir
        mv $orig_bak $inst_dir
        rm -rf $temp_dir
    }
}

# `--wrapped` keeps flags in the launched command (e.g. `java -Xmx4G -jar ...`)
# from being parsed as flags of this script.
def --wrapped main [...rest: string] {
    # --- Initialization ---
    if ($env.INST_DIR? | is-empty) {
        show-error "This script must be run as a Prism Launcher wrapper command."
        exit 1
    }

    if (which rsync | is-empty) {
        show-error "rsync is required for this script. Please install it."
        exit 1
    }

    let inst_dir = $env.INST_DIR
    let instance_name = ($inst_dir | path basename)
    let instance_id = ($env.INST_ID? | default $instance_name)
    let temp_dir = ([$TEMP_BASE $instance_id] | path join)
    let orig_bak = $"($inst_dir).orig_bak"

    # --- Setup Phase ---
    # A leftover backup means a previous run crashed. Recover from it instead
    # of deleting it -- unlike the old bash version this script cannot trap
    # SIGINT/SIGTERM, so the backup may be the only intact copy.
    if ($orig_bak | path exists) {
        print $"Recovering leftover backup from a previous run: ($orig_bak)"
        restore $inst_dir $orig_bak $temp_dir
    }

    if (($inst_dir | path type) == "symlink") {
        show-error $"($inst_dir) is already a symlink. Is another instance already running with this wrapper?"
        exit 1
    }

    mkdir $TEMP_BASE

    # Move original to backup and create a temporary symlink immediately so
    # the instance does not disappear from Prism Launcher's view.
    mv $inst_dir $orig_bak
    ^ln -s $orig_bak $inst_dir

    # Sync to temporary directory.
    with-progress "Preparing instance in RAM..." {
        ^rsync -a ...$EXCLUDES $"($orig_bak)/" $"($temp_dir)/"
    }

    # Point the symlink to the RAM disk version.
    ^ln -sfT $temp_dir $inst_dir

    # --- Launch Phase ---
    if ($rest | is-empty) {
        show-error "No command was passed to the wrapper."
        restore $inst_dir $orig_bak $temp_dir
        exit 1
    }

    try { ^($rest | first) ...($rest | skip 1) } catch { }
    let exit_code = $env.LAST_EXIT_CODE

    restore $inst_dir $orig_bak $temp_dir

    exit $exit_code
}
